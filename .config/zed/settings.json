// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "semantic_tokens": "combined",
  "inlay_hints": {
    "enabled": false
  },
  "collaboration_panel": {
    "button": false
  },
  "agent": {
    "thinking_display": "preview",
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "glm/glm-5.3-flash",
      "enable_thinking": false
    }
  },
  "show_edit_predictions": false,
  "helix_mode": true,
  "cli_default_open_behavior": "existing_window",
  "terminal": {
    "shell": {
      "program": "fish"
    },
    "env": {
      "EDITOR": "zeditor --wait"
    }
  },
  "colorize_brackets": true,
  "tab_size": 2,
  "ui_font_family": "Inter",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "redact_private_values": true,
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "languages": {
    "Zig": {
      "tab_size": 4
    },
    "Python": {
      "language_servers": ["ty", "ruff"],
      "tab_size": 4
    },
    "SQL": {
      "tab_size": 4
    },
    "Java": {
      "tab_size": 4
    },
    "Rust": {
      "tab_size": 4,
      "formatter": "language_server"
    },
    "Dart": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll": true
      }
    },
    "CSS": {
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "HTML": {
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JavaScript": {
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSON": {
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSONC": {
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Markdown": {
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TypeScript": {
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TSX": {
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "YAML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  },
  "file_types": {
    "Markdown": ["svx"]
  },
  "prettier": {
    "allowed": false
  },
  "format_on_save": "on",
  "lsp": {
    "zls": {
      "settings": {
        "zls": {
          "enable_build_on_save": true
        }
      }
    }
  }
}
